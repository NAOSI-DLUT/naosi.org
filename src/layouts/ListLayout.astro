---
import Layout from "./Layout.astro";

const { title } = Astro.props;
---

<Layout title={title}>
  <section class="mx-auto max-w-3xl">
    <div class="mb-8 border-b border-line pb-7">
      <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-primary">NAOSI archive</p>
      <h1 class="m-0 text-4xl font-black tracking-tight sm:text-5xl">
        <span class="mr-2 font-mono text-primary" aria-hidden="true">#</span>{title}
      </h1>
    </div>
    <div class="rounded-2xl border border-line bg-white px-5 shadow-sm sm:px-7">
      <slot />
    </div>
  </section>
</Layout>
