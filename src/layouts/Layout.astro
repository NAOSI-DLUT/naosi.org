---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="大连理工大学网络与开源协会：连接校园技术爱好者，共建开放、实用的项目与服务。"
    />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#549b35" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="NAOSI 社团博客"
      href="/feed.xml"
    />
    <title>
      {title ? `${title} | NAOSI` : "NAOSI"}
    </title>
  </head>
  <body class="bg-paper text-ink antialiased">
    <Header />
    <main
      class="relative max-w-6xl mx-auto min-h-[calc(100vh-12rem)] px-4 py-8 sm:px-6 sm:py-12 lg:px-8"
    >
      <slot />
    </main>
    <Footer />
    <a
      href="https://qm.qq.com/q/AxAh9JeZs4"
      target="_blank"
      rel="noreferrer"
      class="sm:hidden fixed bottom-5 right-4 z-20 inline-flex items-center gap-2 rounded-full bg-primary px-4 py-3 text-sm font-bold text-white shadow-lg shadow-primary/25"
    >
      <span class="i-ri-group-fill" aria-hidden="true"></span>
      加入社团
    </a>
  </body>
</html>

<style is:global>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    color-scheme: light;
  }

  body {
    margin: 0;
    background-image: radial-gradient(
      circle at 12% 0%,
      rgb(84 155 53 / 0.055),
      transparent 24rem
    );
  }

  ::selection {
    background: #dceecf;
    color: #192219;
  }

  :focus-visible {
    outline: 3px solid rgb(84 155 53 / 0.45);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    a,
    button {
      transition:
        color 160ms ease,
        background-color 160ms ease,
        border-color 160ms ease,
        transform 160ms ease;
    }
  }
</style>
