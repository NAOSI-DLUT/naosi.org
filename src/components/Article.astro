---
import PlainTextWrapper from "./PlainTextWrapper.astro";
import Tag from "./Tag.astro";
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"blog"> | CollectionEntry<"events">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const location = "location" in entry.data ? entry.data.location : undefined;
const tags = "tags" in entry.data ? entry.data.tags : undefined;
---

<article class="group border-b border-line py-5 last:border-b-0">
  <div class="flex flex-wrap items-center gap-2">
    <a
      class="mr-auto text-lg font-bold leading-snug text-ink decoration-none group-hover:text-primary-dark"
      href={`/${entry.collection}/${entry.id}`}>{entry.data.title}</a
    >
    {
      entry.data.date && (
        <Tag>
          <span class="i-ri-calendar-event-fill" />
          <span>{entry.data.date.toLocaleDateString()}</span>
        </Tag>
      )
    }
    {
      location && (
        <Tag>
          <span class="i-ri-map-pin-2-fill" />
          <span>{location}</span>
        </Tag>
      )
    }
    {tags?.map((tag) => <Tag>{tag}</Tag>)}
  </div>
  <p class="summary mb-0 mt-3 break-words text-sm leading-6 text-muted">
    <PlainTextWrapper limit="200">
      <Content />
    </PlainTextWrapper>
  </p>
  <a
    class="mt-3 inline-flex items-center gap-1 text-xs font-bold uppercase tracking-wider text-primary decoration-none"
    href={`/${entry.collection}/${entry.id}`}
  >
    阅读更多
    <span class="i-ri-arrow-right-line" aria-hidden="true"></span>
  </a>
</article>

<style>
  .summary {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
</style>
