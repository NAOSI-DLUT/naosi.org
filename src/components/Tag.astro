---
interface Props {
  href?: string;
}

const { href } = Astro.props;
const classes =
  "inline-flex items-center gap-1 rounded-full border border-primary/15 bg-primary-soft px-2.5 py-1 text-xs font-medium leading-none text-primary-dark decoration-none";
---

{
  href ? (
    <a class={classes} href={href} target="_blank" rel="noreferrer">
      <slot />
    </a>
  ) : (
    <span class={classes}>
      <slot />
    </span>
  )
}
