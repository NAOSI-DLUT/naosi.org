---
interface Props {
  icon: string;
  href: string;
  title: string;
  description?: string;
}
const { icon, href, title, description } = Astro.props;
---

<a
  class="group relative min-h-34 overflow-hidden rounded-xl border border-line bg-white p-4 decoration-none shadow-sm hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-md"
  href={href}
  target="_blank"
  rel="noreferrer"
>
  <div class="flex items-start justify-between">
    <span
      class="grid h-10 w-10 place-items-center rounded-lg bg-primary-soft"
      aria-hidden="true"
    >
      <span class={`text-6 text-primary-dark ${icon}`}></span>
    </span>
    <span
      class="i-ri-arrow-right-up-line text-xl text-muted group-hover:text-primary"
      aria-hidden="true"
    ></span>
  </div>
  <div class="mt-4 text-base font-bold text-ink group-hover:text-primary-dark">
    {title}
  </div>
  <div class="mt-1 text-sm leading-5 text-muted">{description}</div>
  <div
    class="absolute -bottom-8 -right-8 h-20 w-20 rounded-full bg-primary-soft opacity-0 group-hover:opacity-100"
    aria-hidden="true"
  ></div>
</a>
